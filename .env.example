# ==========================================
# DabbaETA Environment Configuration
# ==========================================

# 1. TabPFN Predictor API (Prior Labs)
# Optional: If not provided, DabbaETA automatically uses the local Prior-Fitted Network surrogate.
# License Notice: TabPFN free API key is for non-commercial research/evaluation. Commercial deployment requires a Prior Labs license.
TABPFN_API_KEY=your_tabpfn_api_key_here

# 2. Ollama Local LLM Configuration
# Gemma model running locally on Ollama (http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# 3. Temporal Workflow Server
# Start locally via: temporal server start-dev
TEMPORAL_HOST=localhost:7233

# 4. Sentry Observability & Tracing
# Traces custom spans: 'llm.gemma' and 'tabpfn.predict' with token and latency tags
SENTRY_DSN=
ENVIRONMENT=development

# 5. FastAPI Server
HOST=0.0.0.0
PORT=8000
